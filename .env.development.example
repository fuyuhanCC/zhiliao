# Local development profile. Copy to .env.development.
ENABLE_DEVELOPMENT_SESSIONS=true
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Only VITE_ variables are exposed to the browser.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_PATH=/api/socket.io
VITE_SOCKET_TRANSPORT=auto
DEV_PROXY_TARGET=http://localhost:3000

# Must exactly match the callback registered in the Zhihu hackathon portal
# when testing the complete OAuth flow locally.
ZHIHU_REDIRECT_URI=http://localhost:3000/api/v1/auth/zhihu/callback
ZHIHU_OAUTH_PROFILE_URL=
