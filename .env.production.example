# Production profile. Copy to .env.production and replace the public origin.
ENABLE_DEVELOPMENT_SESSIONS=false
WEB_ORIGIN=https://your-app.aiworks.site

# Keep REST and Socket.IO same-origin in production.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_PATH=/api/socket.io
VITE_SOCKET_TRANSPORT=polling

# Must exactly match the callback registered in the Zhihu hackathon portal.
ZHIHU_REDIRECT_URI=https://your-app.aiworks.site/api/v1/auth/zhihu/callback
