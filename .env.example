# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info

# Web (only VITE_ variables are exposed to the browser)
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_PATH=/socket.io

# Zhihu Data Open Platform / OAuth
ZHIHU_DATA_API_BASE_URL=https://developer.zhihu.com/api/v1
ZHIHU_ZHIDA_API_URL=https://developer.zhihu.com/v1/chat/completions
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_REDIRECT_URI=http://localhost:3000/api/v1/auth/zhihu/callback
ZHIHU_ZHIDA_MODEL=zhida-fast-1p5

# Tencent TRTC
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
TRTC_USER_SIG_TTL_SECONDS=7200

# Speech-to-text provider
ASR_PROVIDER=manual
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_REGION=ap-guangzhou
