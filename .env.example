# Shared configuration and secrets.
# Copy this file to .env. Environment-specific URLs and switches belong in
# .env.development or .env.production (see their example files).

# Application
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
REALTIME_DISCONNECT_GRACE_MS=10000
ROOM_EMPTY_RECLAIM_MS=60000

# Zhihu Data Open Platform / OAuth
ZHIHU_DATA_API_BASE_URL=https://developer.zhihu.com/api/v1
ZHIHU_ZHIDA_API_URL=https://developer.zhihu.com/v1/chat/completions
ZHIHU_ACCESS_SECRET=
ZHIHU_OPENAPI_REQUEST_TIMEOUT_MS=10000
ZHIHU_HOT_TOPICS_CACHE_TTL_SECONDS=300
ZHIHU_MATERIALS_CACHE_TTL_SECONDS=600
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_PROFILE_URL=
ZHIHU_OAUTH_STATE_TTL_SECONDS=600
ZHIHU_OAUTH_REQUEST_TIMEOUT_MS=10000
ZHIHU_ZHIDA_MODEL=zhida-fast-1p5
ZHIHU_ZHIDA_REQUEST_TIMEOUT_MS=30000

# Tencent TRTC
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
TRTC_USER_SIG_TTL_SECONDS=7200

# Speech-to-text provider (disabled | tencent_flash)
ASR_PROVIDER=disabled
TENCENT_CLOUD_APP_ID=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_ASR_ENGINE_TYPE=16k_zh
TENCENT_ASR_REQUEST_TIMEOUT_MS=60000
